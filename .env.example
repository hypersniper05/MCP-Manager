# Copy to .env and fill in. .env is gitignored — secrets do not belong in the committed file.
# Generate one: python -c "import secrets; print('mcpm_admin_' + secrets.token_urlsafe(24))"

# The management API and the portal both authenticate with this.
# With it unset the management API fails closed (503) — it does not run open.
MCPM_ADMIN_TOKEN=

# Embeddings need nothing here: the model runs inside the manager, downloaded from Hugging Face
# on first start (embeddinggemma-300m, 4-bit ONNX, ~220 MB, not gated). Set HF_TOKEN only if
# your network needs one for that download.
# HF_TOKEN=

# Docker only: who can reach it. The default, 127.0.0.1, is this computer only. 0.0.0.0 is your
# whole network, so turn on HTTPS with it: app keys would otherwise cross the network in the clear.
# Tailscale Serve or a proxy on this computer reaches the manager on localhost, so it needs no
# change here. (Without Docker the same choice is MCPM_HOST.)
# MCPM_PUBLISH=0.0.0.0

# Docker only: the port on this computer, if 8899 is taken.
# MCPM_PORT=8899

# HTTPS (optional): set BOTH and the manager serves TLS itself — no proxy, still one container.
# install.bat --https or ./install.sh --https makes a certificate and sets these for you; the
# README's "HTTPS on your own network" says how the rest works. Half a config — one variable, or a
# missing file — stops the start rather than quietly serving plain HTTP. Unset = plain HTTP. In
# Docker the paths are inside the container (see the volumes in docker-compose.yml).
# MCPM_TLS_CERT=
# MCPM_TLS_KEY=
